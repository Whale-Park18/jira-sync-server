# 서버 설정
SERVER_PASSWORD=change_me_before_deploy
SECRET_KEY=generate_a_random_64_char_string_here
APP_PORT=8000
DOMAIN=your-domain.example.com

# 로컬 개발 시 ENVIRONMENT=development 로 설정하면 세션 쿠키의 secure 플래그가 비활성화됩니다
# 프로덕션에서는 이 값을 변경하지 마세요 (기본값: production)
ENVIRONMENT=production

# lm2 호스트에서 jira-sync 디렉토리의 절대 경로
# .env와 sync_config.yaml이 이 안에 있어야 합니다
JIRA_SYNC_DIR=/home/user/jira-sync
