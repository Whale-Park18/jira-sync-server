# ── 서버 설정 ──────────────────────────────────────
SERVER_PASSWORD=your-secure-password
SECRET_KEY=change-this-to-a-long-random-string
SERVER_PORT=8000

# jira-sync 경로 (docker-compose 볼륨 마운트 기준)
JIRA_SYNC_DIR=../jira-sync
JIRA_SYNC_CONFIG=/jira-sync/sync_config.yaml

# ── Jira 인증정보 ───────────────────────────────────
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# ── Notion 인증정보 ─────────────────────────────────
NOTION_API_KEY=secret_your-notion-integration-key
NOTION_DATA_SOURCE_ID=your-notion-database-id
